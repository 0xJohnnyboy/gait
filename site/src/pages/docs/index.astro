---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Docs — gait">
  <main class="mx-auto min-h-screen max-w-5xl px-5 py-10 sm:px-8">
    <a href="/gait/" class="text-sm text-[#52e5d0]">← Back to gait</a>
    <div class="mt-20 max-w-3xl"><div class="eyebrow mb-5">documentation</div><h1 class="display text-5xl font-semibold text-white">Build with behavioral signals.</h1><p class="mt-6 text-lg leading-8 text-slate-400">The practical guide to capturing, aggregating and consuming gait snapshots.</p></div>
    <div class="mt-14 grid gap-4 sm:grid-cols-2"><a class="glass rounded-3xl p-6 transition hover:-translate-y-1" href="/gait/docs/quickstart/"><div class="text-xs uppercase tracking-widest text-[#52e5d0]">01 · start here</div><h2 class="mt-8 text-xl font-semibold text-white">Quickstart</h2><p class="mt-2 text-sm leading-6 text-slate-400">Create a browser collector and inspect your first local snapshot.</p></a><a class="glass rounded-3xl p-6 transition hover:-translate-y-1" href="/gait/docs/architecture/"><div class="text-xs uppercase tracking-widest text-[#9b8cff]">02 · under the hood</div><h2 class="mt-8 text-xl font-semibold text-white">Architecture</h2><p class="mt-2 text-sm leading-6 text-slate-400">Core, browser source, adapters and the performance boundary.</p></a></div>
  </main>
</Layout>
